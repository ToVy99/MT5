import os
from flask import Flask, request, jsonify
import requests

app = Flask(__name__)

# Bộ nhớ tạm lưu PnL cho Widget Android
pnl_data = {
    "total_pnl": 0.0,
    "open_count": 0,
    "positions": []
}

# Điền Token Bot và Chat ID Telegram của bạn vào 2 dòng này:
TELEGRAM_BOT_TOKEN = "8744695030:AAFFNtVB5mmzut05PdiKE0OMiH5wLju1r-g"
TELEGRAM_CHAT_ID = "8451431517"

def send_telegram(message):
    if TELEGRAM_BOT_TOKEN and "ĐIỀN_" not in TELEGRAM_BOT_TOKEN:
        url = f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage"
        payload = {
            "chat_id": TELEGRAM_CHAT_ID,
            "text": message,
            "parse_mode": "HTML"
        }
        try:
            requests.post(url, json=payload, timeout=5)
        except Exception as e:
            print(f"Lỗi gửi Telegram: {e}")

@app.route('/update_pnl', methods=['POST'])
def update_pnl():
    global pnl_data
    try:
        data = request.get_json()
        if not data:
            return jsonify({"status": "error", "message": "No data"}), 400

        pnl_data = data

        total_pnl = data.get("total_pnl", 0.0)
        open_count = data.get("open_count", 0)

        # Gửi thông báo sang Telegram
        msg = f"📊 <b>Cập nhật PnL MT5</b>\n💰 PnL: <b>{total_pnl:+.2f} USD</b>\n📈 Lệnh mở: {open_count}"
        send_telegram(msg)

        return jsonify({"status": "success"}), 200
    except Exception as e:
        return jsonify({"status": "error", "message": str(e)}), 500

@app.route('/get_pnl', methods=['GET'])
def get_pnl():
    return jsonify(pnl_data), 200

if __name__ == '__main__':
    port = int(os.environ.get('PORT', 5000))
    app.run(host='0.0.0.0', port=port)
