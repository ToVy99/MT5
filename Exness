from flask import Flask, request, jsonify

app = Flask(__name__)

# Bộ nhớ tạm lưu dữ liệu PnL
pnl_data = {
    "total_pnl": 0.0,
    "open_count": 0,
    "positions": []
}

# 1. MT5 VPS gửi dữ liệu vào đây
@app.route('/update_pnl', methods=['POST'])
def update_pnl():
    global pnl_data
    try:
        data = request.get_json(force=True, silent=True) or {}
        positions = data.get("positions", [])
        total = sum(float(p.get('profit', 0.0)) for p in positions)
        
        pnl_data = {
            "total_pnl": total,
            "open_count": len(positions),
            "positions": positions
        }
        return jsonify({"status": "ok"}), 200
    except Exception as e:
        return jsonify({"error": str(e)}), 500

# 2. Widget Android gọi vào đây để hiển thị ra màn hình
@app.route('/get_pnl', methods=['GET'])
def get_pnl():
    return jsonify(pnl_data), 200

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5000)
